{
  "name": "soundboard-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=10.34.8 <11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "ipc:export": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings",
    "i18n:check": "node scripts/i18n/check-catalogs.mjs",
    "test:scripts": "node --test scripts/i18n/i18n.test.mjs scripts/format/duration.test.mjs scripts/format/gain.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "i18next": "26.5.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
